rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaffUser(userData) {
      return userData != null && userData.role != 'customer';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated() && isStaffUser(getUserData()) && (getUserData().role == 'admin' || getUserData().role == 'manager');
    }

    // products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() && isStaffUser(getUserData()) && (getUserData().role == 'admin' || getUserData().role == 'manager');
    }

    // users
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isStaffUser(getUserData()));
      allow write: if isAuthenticated() && (isOwner(userId) || getUserData().role == 'admin');
    }

    // addresses
    match /addresses/{addressId} {
      allow read, write: if isAuthenticated() && (resource == null || isOwner(resource.data.userId) || isOwner(request.resource.data.userId) || isStaffUser(getUserData()));
    }

    // orders
    match /orders/{orderId} {
      allow create: if isAuthenticated() && (isOwner(request.resource.data.userId) || isOwner(request.resource.data.customerId));
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isOwner(resource.data.customerId) || isStaffUser(getUserData()));
      allow update: if isAuthenticated() && (
        isStaffUser(getUserData()) ||
        ((isOwner(resource.data.userId) || isOwner(resource.data.customerId)) &&
         request.resource.data.status == 'Cancelled' &&
         resource.data.status == 'Pending' &&
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.total == resource.data.total)
      );
      allow delete: if isAuthenticated() && isStaffUser(getUserData());
    }

    // audit_logs
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && getUserData().role == 'admin';
      allow update, delete: if false;
    }

    // settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated() && getUserData().role == 'admin';
    }

    // coupons
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isStaffUser(getUserData()) && (getUserData().role == 'admin' || getUserData().role == 'manager');
    }

    // offers
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAuthenticated() && isStaffUser(getUserData()) && (getUserData().role == 'admin' || getUserData().role == 'manager');
    }

    // weight_units
    match /weight_units/{unitId} {
      allow read: if true;
      allow write: if isAuthenticated() && getUserData().role == 'admin';
    }

    // stock_history
    match /stock_history/{historyId} {
      allow read, write: if isAuthenticated() && isStaffUser(getUserData());
    }

    // suppliers
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && isStaffUser(getUserData());
      allow write: if isAuthenticated() && isStaffUser(getUserData()) && (getUserData().role == 'admin' || getUserData().role == 'manager');
    }

    // purchase_orders
    match /purchase_orders/{poId} {
      allow read, write: if isAuthenticated() && isStaffUser(getUserData());
    }

    // supplier_payments
    match /supplier_payments/{paymentId} {
      allow read: if isAuthenticated() && isStaffUser(getUserData());
      allow write: if isAuthenticated() && isStaffUser(getUserData()) && (getUserData().role == 'admin' || getUserData().role == 'manager');
    }

    // expenses
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && isStaffUser(getUserData());
      allow write: if isAuthenticated() && isStaffUser(getUserData()) && (getUserData().role == 'admin' || getUserData().role == 'manager');
    }

    // warehouses
    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isStaffUser(getUserData()) && (getUserData().role == 'admin' || getUserData().role == 'manager');
    }

    // warehouse_inventories
    match /warehouse_inventories/{inventoryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isStaffUser(getUserData()) && (getUserData().role == 'admin' || getUserData().role == 'manager');
    }

    // stock_transfers
    match /stock_transfers/{transferId} {
      allow read: if isAuthenticated() && isStaffUser(getUserData());
      allow write: if isAuthenticated() && isStaffUser(getUserData()) && (getUserData().role == 'admin' || getUserData().role == 'manager');
    }

    // batches
    match /batches/{batchId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isStaffUser(getUserData());
    }
  }
}
